rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role == 'admin';
    }

    // Each person may read only their own account role. Create roles in the
    // Firebase console or through a trusted server, never from the app.
    match /user/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Only administrators can access store data.
    match /{document=**} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
